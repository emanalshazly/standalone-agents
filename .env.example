# Environment Variables for Standalone Agents
# Copy this file to .env and update with your actual values

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Environment
ENVIRONMENT=development  # development, staging, production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Security
API_KEY_ENABLED=false
API_KEYS=key1,key2,key3

# Performance
MAX_WORKERS=5
REQUEST_TIMEOUT=30
CACHE_TTL=3600

# Database
VECTOR_DB_PATH=./src/knowledge/vectors
LEARNING_DATA_PATH=./src/knowledge/learning
