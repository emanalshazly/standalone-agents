# Environment Variables - Egyptian Legal-Literacy Agent
# Copy this file to .env and update with your actual values

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Environment
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Admin auth for /feedback/review-queue, /feedback/{id}/approve, /feedback/{id}/reject
# Leave unset to disable these endpoints entirely (they 503 rather than being open).
LEGAL_AGENT_ADMIN_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Storage paths
VECTOR_DB_PATH=./src/knowledge/vectors/legal_eg
FEEDBACK_DB_PATH=./src/knowledge/feedback/review_queue.db
